<?xml version="1.0"?>
<robot name="Differntial_Bot">


<link name="base_footprint_link"/>


  <link name="base_cylinder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.2" />
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.1"/>
      </geometry>
    </collision>
  </link>

    <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15" />
      </geometry>
        <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15" />
      </geometry>
    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.15"/>
      </geometry>
    </collision>
  </link>

   <link name="base_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.4 0.1" />
      </geometry>
    <material name="green">
        <color rgba="0 1 0 1"/>
    </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.3" />
      </geometry>
    </collision>
  </link>
   
   <link name="camera_stand_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
           <cylinder radius="0.08" length="0.8" />
      </geometry>
    <material name="black">
        <color rgba="1 1 1 1"/>
    </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.8" />
      </geometry>
    </collision>
  </link>

<joint name="base_cylinder_to_base_mount_joint" type="fixed">
    <parent link="base_cylinder_link"/>
    <child link="base_mount_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

<joint name="base_mount_to_camera_stand_joint" type="fixed">
    <parent link="base_mount_link"/>
    <child link="camera_stand_link"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
  </joint>

<joint name="base_footprint_to_cylinder_joint" type="fixed">
    <parent link="base_footprint_link"/>
    <child link="base_cylinder_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

 <joint name="base_cylinder_to_left_wheel_joint" type="fixed">
    <parent link="base_cylinder_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0.8 0 0" rpy="1.57 0 1.57"/>
  </joint>

<joint name="base_cylinder_to_right_wheel_joint" type="fixed">
    <parent link="base_cylinder_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="-0.8 0 0" rpy="1.57 0 1.57"/>
  </joint>

  
 
</robot>
